generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  firstName     String?
  middleName    String?
  lastName      String?
  gender        String?
  phone         String?
  dob           DateTime?
  placeOfBirth  String?
  bloodGroup    String?
  maritalStatus String?
  dateOfJoining DateTime?
  leaveOfDate   DateTime?
  designation   String?
  address       String?
  photo         String?
  role          String    @default("Admin")
  isFirstLogin  Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("active")
  
  permissions RolePermission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model RolePermission {
  id        String   @id @default(uuid())
  module    String
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  canDelete Boolean  @default(false)
  
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module])
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Branch {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  city              String
  address           String
  phone             String
  email             String
  gstin             String
  lanes             Int
  capacity          Int
  armsLicense       String
  armsLicenseExpiry String
  status            String   @default("active")
  manager           String
  workingHours      String
  
  // Relations
  members           Member[]
  s1Members         S1Member[]
  leads             Lead[]
  employees         Employee[]
  inventoryItems    InventoryItem[]
  ammunitions       AmmunitionRecord[]
  payments          Payment[]
  incidents         Incident[]
  trainingBatches   TrainingBatch[]
  assets            Asset[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Member {
  id             String   @id @default(uuid())
  memberId       String   @unique
  name           String
  email          String
  phone          String
  photo          String?
  dob            DateTime?
  bloodGroup     String?
  qualification  String?
  occupation     String?
  address        String?
  state          String?
  country        String?
  pincode        String?
  emergencyContactName   String?
  emergencyContactNumber String?
  age            Int
  gender         String
  caste          String?
  package        String
  status         String
  joinDate       DateTime
  expiryDate     DateTime
  discipline     String
  coach          String
  batch          String
  attendanceRate Float    @default(0)
  totalPaid      Float    @default(0)
  dueAmount      Float    @default(0)
  nraiId         String?
  safetyExpiry   String?

  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  
  payments       Payment[]
  outstandingCharges OutstandingCharge[]
  subscriptions  MemberSubscription[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model S1Member {
  id             String   @id @default(uuid())
  s1MemberId     String   @unique
  name           String
  email          String
  phone          String
  photo          String?
  dob            DateTime?
  bloodGroup     String?
  qualification  String?
  occupation     String?
  address        String?
  state          String?
  country        String?
  pincode        String?
  emergencyContactName   String?
  emergencyContactNumber String?
  age            Int
  gender         String
  caste          String?
  package        String
  status         String
  joinDate       DateTime
  expiryDate     DateTime
  discipline     String
  coach          String
  batch          String
  attendanceRate Float    @default(0)
  totalPaid      Float    @default(0)
  dueAmount      Float    @default(0)
  nraiId         String?
  safetyExpiry   String?

  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  
  outstandingCharges OutstandingCharge[]
  subscriptions      MemberSubscription[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Lead {
  id               String   @id @default(uuid())
  name             String
  phone            String
  email            String
  age              Int
  source           String
  stage            String
  owner            String
  preferredPackage String?
  preferredTime    String?
  message          String?
  lastFollowUp     DateTime?
  nextFollowUp     DateTime?

  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Employee {
  id          String   @id @default(uuid())
  empId       String   @unique
  name        String
  email       String
  phone       String
  photo       String?
  role        String
  department  String
  joinDate    DateTime
  status      String
  salary      Float
  reportingTo String?

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model InventoryItem {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  category     String
  make         String
  model        String
  serialNumber String?
  quantity     Int
  reorderLevel Int
  unitPrice    Float
  status       String
  lastUpdated  DateTime

  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Asset {
  id            String   @id @default(uuid())
  assetCode     String   @unique
  name          String
  category      String
  serialNumber  String?
  purchaseDate  DateTime
  purchaseValue Float
  currentValue  Float
  assignedTo    String?
  status        String
  warranty      String?
  condition     String

  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model AmmunitionRecord {
  id           String   @id @default(uuid())
  caliber      String
  type         String
  batchLot     String
  openingStock Int
  received     Int
  issued       Int
  returned     Int
  consumed     Int
  closingStock Int
  date         DateTime
  issuedTo     String?
  authorizedBy String?
  lane         String?
  purpose      String?

  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Payment {
  id         String   @id @default(uuid())
  receiptNo  String   @unique
  memberName String
  amount     Float
  tax        Float
  total      Float
  mode       String
  status     String
  type       String
  date       DateTime
  invoiceNo  String?

  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Incident {
  id               String   @id @default(uuid())
  incidentNo       String   @unique
  type             String
  severity         String
  date             DateTime
  description      String
  reportedBy       String
  lane             String?
  involvedPerson   String?
  status           String
  correctiveAction String?

  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model TrainingBatch {
  id         String   @id @default(uuid())
  name       String
  coach      String
  discipline String
  level      String
  capacity   Int
  enrolled   Int
  schedule   String
  time       String
  days       String[]
  status     String

  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model Guest {
  id          String   @id @default(uuid())
  guestId     String   @unique
  institute   String
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String
  email       String
  mobile      String
  address     String?
  city        String?
  state       String?
  country     String?
  pincode     String?
  status      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model IssueItemRecord {
  id                String   @id @default(uuid())
  institute         String
  memberOrGuest     String
  memberIdOrGuestId String
  fullName          String
  issueId           String   @unique
  issueDate         DateTime
  paymentTerm       String
  totalQuantity     Int
  totalPayable      Float
  totalDue          Float

  items             IssueItemDetail[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model IssueItemDetail {
  id              String   @id @default(uuid())
  itemCategory    String
  itemSubCategory String
  item            String
  uom             String
  returnDate      DateTime?
  quantity        Int

  issueRecordId   String
  issueRecord     IssueItemRecord @relation(fields: [issueRecordId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model MembershipName {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model MembershipCharge {
  id          String   @id @default(uuid())
  institute   String
  name        String
  days        Int
  wefDate     DateTime
  cost        Float
  renewalCost Float    @default(0)
  gst         String
  renewal     Boolean  @default(false)
  status      String   @default("Active") // Active or Inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model FinancialYear {
  id          String   @id @default(uuid())
  name        String   @unique
  fromDate    DateTime
  toDate      DateTime
  currentYear Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
}

model OutstandingCharge {
  id          String   @id @default(uuid())
  chargeType  String
  amount      Float
  dueDate     DateTime
  status      String   @default("Pending") // Pending, Paid, Overdue
  
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id])
  
  s1MemberId  String?
  s1Member    S1Member? @relation(fields: [s1MemberId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
}

model MemberSubscription {
  id          String   @id @default(uuid())
  institute   String
  membershipCharge String
  amount      Float
  amountDue   Float    @default(0)
  startDate   DateTime
  endDate     DateTime
  
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id])
  
  s1MemberId  String?
  s1Member    S1Member? @relation(fields: [s1MemberId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
}

